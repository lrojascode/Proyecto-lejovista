# ═══ LejoVista — Variables de Entorno ═══

# --- Desarrollo Local vs Producción ---
# En local, usa MOCK_SERVICES=true para probar todo sin credenciales de Meta ni OpenRouter.
MOCK_SERVICES=true

# --- Dominio (cambiar aquí para migrar) ---
# Local: localhost
# Producción: lrojas.dev o lejovista.com
BASE_DOMAIN=localhost:3000
API_URL=http://api.localhost:8000

# --- Base de Datos ---
DB_USER=lejovista
DB_PASSWORD=localpassword123
DB_NAME=lejovista
# Conexión asíncrona usando asyncpg (para SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://lejovista:localpassword123@db:5432/lejovista

# --- Configuración de Puertos Locales (para evitar colisiones) ---
# Si el puerto 5432 ya está ocupado en tu Mac, el contenedor mapeará al puerto 5433 en tu host.
DB_PORT=5433
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
# En macOS, los puertos 80 y 443 pueden requerir privilegios o estar en uso.
# Si el contenedor Nginx falla al iniciar, puedes cambiarlos aquí a 8080 y 8443.
NGINX_PORT=80
NGINX_SSL_PORT=443

# --- Redis ---
REDIS_PASSWORD=localredispassword123
REDIS_URL=redis://:localredispassword123@redis:6379/0

# --- Seguridad ---
# NUNCA committear claves reales aquí. Genera las tuyas y ponlas solo en .env (gitignored):
#   SECRET_KEY:     openssl rand -hex 64
#   ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#                   (o: openssl rand -base64 32 | tr '+/' '-_')
SECRET_KEY=changeme-generate-with-openssl-rand-hex-64
ENCRYPTION_KEY=changeme-generate-a-valid-fernet-key

# --- Observabilidad ---
# DSN de Sentry (opcional). Vacío => desactivado. Nivel de log: DEBUG/INFO/WARNING.
# Observabilidad. En PRODUCCIÓN configúralo siempre: los fallos de sync/IA
# ocurren en los workers y sin Sentry nadie se entera (D-2).
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Correo transaccional (Brevo) ---
# Sin BREVO_API_KEY el backend NO envía nada: invitaciones, avisos de token
# vencido y recuperación de contraseña quedan sin salir. En local se deja vacía
# a propósito (MOCK_SERVICES ya simula el envío y lo loguea).
BREVO_API_KEY=
EMAIL_FROM=notificaciones@lejovista.com
EMAIL_FROM_NAME=Agente DX IA

# --- Meta Ads API ---
META_APP_ID=mock_app_id
META_APP_SECRET=mock_app_secret
# Versión de la Graph/Marketing API (las versiones expiran a los ~2 años;
# ver https://developers.facebook.com/docs/graph-api/changelog)
META_API_VERSION=v25.0

# --- OpenRouter (IA) ---
# Dejar vacío si MOCK_SERVICES=true
OPENROUTER_API_KEY=
DEFAULT_AI_MODEL=google/gemini-2.5-flash

# --- Feature flags ---
# Escrituras reales a Meta (pausar/ajustar/crear campañas). Independiente de
# MOCK_SERVICES. Mantener en false hasta validar los parámetros del AI Planner.
ENABLE_META_WRITEBACK=false

# F-2: encendido controlado. ENABLE_META_WRITEBACK es un flag GLOBAL — sin
# esto, activarlo escribe de verdad en TODAS las cuentas del parque a la vez.
# Lista de AdAccount.id (no el external_account_id de Meta) separados por
# comas para restringir la escritura real solo a la(s) cuenta(s) piloto
# mientras se valida el checklist de F-2 (ver HANDOFF.md). Vacío = todas las
# cuentas (comportamiento anterior a esta protección).
WRITEBACK_ACCOUNT_ALLOWLIST=

# Crear tablas al arrancar (create_all). Solo dev/test. En producción: false y
# usar `alembic upgrade head` para gestionar el esquema.
AUTO_CREATE_TABLES=false

# /docs, /redoc y /openapi.json exponen el esquema completo de la API sin
# auth. Poner en false al exponer la app públicamente (ej. túnel ngrok).
ENABLE_API_DOCS=true

# Patrón extra (regex) de origen permitido por CORS, ej. el hostname de un
# túnel ngrok/Cloudflare: ^https://tu-dominio\.ngrok-free\.app$
TUNNEL_ORIGIN_REGEX=
